<sect1 id="menu-items">
<title
>Пункты меню</title>
<variablelist>

<varlistentry>
<term
><menuchoice
> <shortcut
><keycap
>N</keycap
></shortcut
> <guimenu
>Игра</guimenu
><guimenuitem
>Новая головоломка</guimenuitem
> </menuchoice
> <menuchoice
> <shortcut
><keycombo action="simul"
>&Ctrl;<keycap
